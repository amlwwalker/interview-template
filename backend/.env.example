# Copy to .env — `make db` writes one for you with your macOS username filled in.

# Local Postgres over the default socket/port. On a Homebrew or Postgres.app
# install your macOS username is a superuser with no password, which is why
# there is no password segment here.
DATABASE_URL=postgres://YOUR_MAC_USERNAME@localhost:5432/crud_dev?sslmode=disable

PORT=8080

# Comma-separated. Vite dev server defaults to 5173. Both spellings are listed
# because a browser treats localhost and 127.0.0.1 as different origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
