# Copy to .env — `make db` writes one for you with your macOS username filled in.

# The same database the Go backend uses. One schema, two implementations.
DATABASE_URL=postgres://YOUR_MAC_USERNAME@localhost:5432/crud_dev?sslmode=disable

# Same port as the Go backend, so the frontend needs no change when you switch.
# Run one or the other, not both.
PORT=8080

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
